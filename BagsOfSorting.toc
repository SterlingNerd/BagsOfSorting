# Load order: core -> filters -> data -> layout -> frames -> config -> integrations -> core/init.
# Category is what the client's own AddonList groups the addon list by (AddonList.lua reads the
# "Category" metadata); X-Category is CurseForge/Wago metadata the client never reads.
# IconTexture keeps the .png extension: an extensionless lookup probes .blp and .tga only.
# shortcut: docs/03 lists filters after frames. The field registry is data the classifier
# reads on every leaf, so it loads before data/ instead of being looked up per leaf.
# Bindings.xml is deliberately absent: the client loads it itself and listing it here would
# load it twice. tests/ is absent too: the harness runs off the client (`lua5.1 tests/run.lua`),
# so the addon loads zero test code in a dev checkout as well as in a release zip.
core\boot.lua
core\log.lua
core\client.lua
core\constants.lua
core\locale.lua
core\events.lua
core\context.lua
core\async.lua
core\pool.lua
core\db.lua

filters\registry.lua
filters\fields.lua

data\harvest.lua
data\itemcache.lua
data\enrich.lua
data\rules.lua
data\classify.lua
data\sort.lua
data\pipeline.lua

layout\flow.lua
layout\anchors.lua

frames\item.lua
frames\section.lua
frames\money.lua
frames\window.lua

config\keybinds.lua
config\settingspanel.lua

integrations\compartment.lua

# core/interactions.lua is core wiring, but it loads after the frames layer because it drives it:
# it opens and closes our windows when the client opens a vendor or the bank (issue #38).
core\interactions.lua

core\diag.lua
core\init.lua
